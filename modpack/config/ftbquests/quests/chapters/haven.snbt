			y: 0.0d
		}
		{
			dependencies: ["50BFB3D0079383A0"]
			description: [
				"Le bar du Hip Hog, où l'équipe se retrouve. Au bout du comptoir, la &cborne&r lance la partie : choisissez ensemble, la vitre bleue pour le Monde ouvert, la rouge pour le Défi."
				""
				"Le bouton, près de la borne, fait passer toute la ville de paisible à envahie. Il n'obéit qu'à ceux qui ont débloqué les douze armes du Morph Gun."
				""
				"&7Se coche au premier pas dans le bar."
			]
			icon: {
				id: "minecraft:bell"
			}
			id: "2C29095DC701E91E"
			rewards: [
			]
			size: 1.25d
