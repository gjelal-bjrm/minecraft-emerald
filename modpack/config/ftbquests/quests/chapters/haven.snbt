	quests: [
		{
			description: [
				"Vous vous réveillez dans votre appartement, au port de &bHaven&r. La ville est calme : ses habitants et ses voitures volantes vont et viennent. Vous n'avez pas d'arme."
				""
				"Le quartier général, c'est le &6bar du Hip Hog&r. Votre &6agenda&r (clic droit) donne le prochain rendez-vous ; la barre en haut de l'écran, la distance et la direction. Une voiture vous attend devant l'appartement."
				""
				"&7Se coche à la première arrivée."
			]
			icon: {
				id: "minecraft:red_bed"
			}
			id: "50BFB3D0079383A0"
			rewards: [
			]
			size: 1.25d
