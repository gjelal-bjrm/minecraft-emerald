{
  "multipart": [
    {
      "when": {
        "axis": "x"
      },
      "apply": {
        "model": "emeraldweapons:block/haven_window_glass"
      }
    },
    {
      "when": {
        "axis": "x",
        "up": "false"
      },
      "apply": {
        "model": "emeraldweapons:block/haven_window_frame_up"
      }
    },
    {
      "when": {
        "axis": "x",
        "down": "false"
      },
      "apply": {
        "model": "emeraldweapons:block/haven_window_frame_down"
      }
    },
    {
      "when": {
        "axis": "x",
        "left": "false"
      },
      "apply": {
        "model": "emeraldweapons:block/haven_window_frame_left"
      }
    },
    {
      "when": {
        "axis": "x",
        "right": "false"
      },
      "apply": {
        "model": "emeraldweapons:block/haven_window_frame_right"
      }
    },
    {
      "when": {
        "axis": "z"
      },
      "apply": {
        "model": "emeraldweapons:block/haven_window_glass",
        "y": 90
      }
    },
    {
      "when": {
        "axis": "z",
        "up": "false"
      },
      "apply": {
        "model": "emeraldweapons:block/haven_window_frame_up",
        "y": 90
      }
    },
    {
      "when": {
        "axis": "z",
        "down": "false"
      },
      "apply": {
        "model": "emeraldweapons:block/haven_window_frame_down",
        "y": 90
      }
    },
    {
      "when": {
        "axis": "z",
        "left": "false"
      },
      "apply": {
        "model": "emeraldweapons:block/haven_window_frame_left",
        "y": 90
      }
    },
    {
      "when": {
        "axis": "z",
        "right": "false"
      },
      "apply": {
        "model": "emeraldweapons:block/haven_window_frame_right",
        "y": 90
      }
    }
  ]
}
